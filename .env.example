# Copy this file to .env and fill in real keys. .env is git-ignored — never commit it.
OPENAI_API_KEY=
KIE_API_KEY=

# Optional: OpenAI model used to write scripts (defaults to the value below).
# OPENAI_MODEL=gpt-5.5
# The clip writer fills a strict JSON schema and invents no dialogue, so it can run on a cheaper
# model than the showrunner, which writes the story and every spoken line. Leave unset to use
# OPENAI_MODEL for both.
# OPENAI_CLIP_MODEL=gpt-6-luna

# Optional: the kie.ai model that draws cast portraits and place pictures (defaults below; 1K = 4 credits a picture, 2K = 6, 4K = 9).
# IMAGE_MODEL=nano-banana-2-1
# IMAGE_RESOLUTION=1K
# IMAGE_FORMAT=jpg

# docker-compose sets this for the api/worker containers already.
# Only set it when running app.py directly on your machine (defaults to the value below).
# REDIS_URL=redis://localhost:6379/0

# Optional: Langfuse observability (free cloud or self-hosted)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=https://cloud.langfuse.com
