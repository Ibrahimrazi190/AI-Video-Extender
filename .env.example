# Copy this file to .env and fill in real keys. .env is git-ignored — never commit it.
OPENAI_API_KEY=
KIE_API_KEY=

# Optional: OpenAI model used to write scripts (defaults to the value below).
# OPENAI_MODEL=gpt-5.5

# docker-compose sets this for the api/worker containers already.
# Only set it when running app.py directly on your machine (defaults to the value below).
# REDIS_URL=redis://localhost:6379/0

# Optional: Langfuse observability (free cloud or self-hosted)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=https://cloud.langfuse.com
